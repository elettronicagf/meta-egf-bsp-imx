#!/bin/sh

eeprom_board=$(find /sys -name "eeprom" | grep 0054)
tag_890=$(strings $eeprom_board | grep JFN0890)
tag_mx8mp=$(strings $eeprom_board | grep mx8mp)
tag_mx93=$(strings $eeprom_board | grep mx93)



# PHYs Realtek Led configuration helper functions

BASE="/sys/class/leds"

write_attr()
{
    value="$1"
    file="$2"

    if [ ! -e "$file" ]; then
        echo "Attribute not found: $file" >&2
        return 1
    fi

    current="$(cat "$file" 2>/dev/null)"

    if [ "$current" = "$value" ]; then
        return 0
    fi

    if ! printf '%s\n' "$value" > "$file"; then
        echo "Cannot write '$value' to $file" >&2
        return 1
    fi
}

reset_trigger()
{
    led="$1"

    printf '%s\n' none > "$led/trigger" || return 1
    printf '%s\n' netdev > "$led/trigger" || return 1
}

wait_for_leds()
{
    led0="$1"
    led1="$2"
    led2="$3"
    count=0

    while [ ! -d "$led0" ] || [ ! -d "$led1" ] || [ ! -d "$led2" ]; do
        count=$((count + 1))

        if [ "$count" -ge 50 ]; then
            return 1
        fi

        sleep 0.1
    done
}

configure_phy_leds()
{
    prefix="$1"

    led0="$BASE/$prefix:green:lan-0"
    led1="$BASE/$prefix:green:lan-1"
    led2="$BASE/$prefix:amber:lan-2"

    echo "Configuring PHY LEDs: $prefix"

    if ! wait_for_leds "$led0" "$led1" "$led2"; then
        echo "PHY LEDs not found for $prefix" >&2
        return 1
    fi

    #
    # LED0: attività TX/RX
    #
    reset_trigger "$led0" || return 1

    # RX e TX devono essere abilitati insieme.
    write_attr 1 "$led0/rx" || true
    write_attr 1 "$led0/tx" || true

    #
    # LED1: link 1000 Mbit/s
    #
    reset_trigger "$led1" || return 1
    write_attr 1 "$led1/link_1000" || true

    #
    # LED2: link 10/100 Mbit/s
    #
    reset_trigger "$led2" || return 1
    write_attr 1 "$led2/link_10" || true
    write_attr 1 "$led2/link_100" || true

    echo "Configured PHY LEDs: $prefix"
}




#mx93/820 on 890
if [[ -n "${tag_890}" && -n "$tag_mx93" ]]; then
    exp_chip=$(find /sys | grep gpio | grep 1-0021 | grep uevent  | awk -F'/' '{print $10}')
    echo "Detected mx93 on 890"
    i2ctransfer -f -y 7 w3@0x2d 0xAA 0x55 0x00
    sleep 1
    
    #Keep Modem in RESET   
    gpioset -z -c gpiochip1 27=1
    pkill -f gpioset

    #Keep Modem in Power Off  M2_B_LTE_FULL_CARD_POWER_OFF_B
    gpioset -z -c $exp_chip 5=0
    pkill -f gpioset

    #Enable Power Supply 3.7V M2_B_LTE_SUPPLY_EN
    gpioset -z -c $exp_chip 7=1
    pkill -f gpioset

    sleep 1
    #Release RESET 
    gpioset -z -c gpiochip1 27=0
    pkill -f gpioset

    sleep 1 
    #Power On  M2_B_LTE_FULL_CARD_POWER_OFF_B
    gpioset -z -c $exp_chip 5=1
    pkill -f gpioset

#detect board
#SOM 800 on 3pb1001/890 with USB HUB and LTE MODULE
elif [ -n "$tag_mx8mp" ]; then
    echo "Detected mx8mp"
    exp_chip=$(find /sys | grep gpio | grep 1-0021 | grep uevent  | awk -F'/' '{print $10}')
    #enable HUB
    gpioset -z -c gpiochip0 14=1
    pkill -f gpioset
    i2ctransfer -f -y 3 w3@0x2d 0xAA 0x55 0x00
    sleep 1

    #Keep Modem in RESET   
    gpioset -z -c gpiochip2 25=1
    pkill -f gpioset

    #Keep Modem in Power Off  M2_B_LTE_FULL_CARD_POWER_OFF_B
    gpioset -z -c $exp_chip 5=0
    pkill -f gpioset

    #Enable Power Supply 3.7V M2_B_LTE_SUPPLY_EN
    gpioset -z -c $exp_chip 7=1
    pkill -f gpioset

    sleep 1
    #Release RESET 
    gpioset -z -c gpiochip2 25=0
    pkill -f gpioset

    sleep 1 
    #Power On  M2_B_LTE_FULL_CARD_POWER_OFF_B
    gpioset -z -c $exp_chip 5=1
    pkill -f gpioset

    configure_phy_leds "30be0000.ethernet-1:02" || status=1
    configure_phy_leds "stmmac-1:01" || status=1

fi








#generic startup script
if [ -x "/root/egf_start" ]; then
    /root/egf_start
fi
