+drmModeModeInfo find_mode(struct drm_backend *b, uint32_t conn_id)
+{
+	drmModeConnector *conn = drmModeGetConnector(b->drm->drm.fd, conn_id);
+
+	int i,j;
+	for(i = 0; i<b->modecount;i++){
+		if(b->cloneoutput[i].conn_id == conn_id){
+			for(j=0;j<conn->count_modes;j++){
+				if(conn->modes[j].hdisplay == b->cloneoutput[i].width && 
+					conn->modes[j].vdisplay == b->cloneoutput[i].height){
+						return conn->modes[j];
+				}
+
+			}
+		}
+	}
+	return conn->modes[0];
+}
