+int drm_clone_output_add(struct drm_output *output, struct drm_backend *b, int connector_id)
+{
+
+	drmModeRes *resources;
+	resources = drmModeGetResources(b->drm->drm.fd);
+	struct drm_device *device = b->drm;
+	uint32_t format = output->format;
+	enum g2d_format g2dFormat;
+	drmModeConnector *conn = drmModeGetConnector(b->drm->drm.fd, connector_id);
+	int clonedmafd = 0;
+	int ret = 0;
+
+	switch (format) {
+		case GBM_FORMAT_XRGB8888:
+			g2dFormat = G2D_BGRX8888;
+			break;
+	case GBM_FORMAT_RGB565:
+			g2dFormat = G2D_RGB565;
+			break;
+		default:
+			weston_log("Unsupported pixman format 0x%x\n", format);
+			return -1;
+	}
+
+
+	b->clone_conn++;
+	if(conn->connection == DRM_MODE_CONNECTED){
+
+		int count = b->clone_conn-1;
+		int i = 0;	
+		for (i = 0; i < ARRAY_LENGTH(output->dumb); i++) {
+			struct clonebuf_list *p = output->dumb[i]->clonebuf;
+			int image_index = i+count*3;
+			struct g2d_surfaceEx* g2dCloneSurface = &(output->g2d_cloneimage[image_index]);
+
+			int clone_width, clone_height;
+			clone_width = b->clone_info[count].mode.hdisplay;
+			clone_height = b->clone_info[count].mode.vdisplay;
+			while( p->next != NULL){
+				p = p->next;
+			}
+			struct clonebuf_list *newp = malloc(sizeof(struct clonebuf_list));
+			if(newp == NULL ){
+				weston_log("Create clonebuf list node fail;\n");
+			}	
+			newp->next = NULL;
+			p->next = newp;
+			newp->prev = p;		
+			p->conn_id = connector_id;						
+			p->clonedumb = drm_fb_create_dumb(device, clone_width, clone_height, format);
+			ret = drmPrimeHandleToFD(b->drm->drm.fd, p->clonedumb->handles[0], DRM_CLOEXEC, &clonedmafd);
+
+			if(ret < 0){
+				free(newp);
+			}
+			ret = b->g2d_renderer->create_g2d_image(g2dCloneSurface, g2dFormat,
+					p->clonedumb->map,
+					clone_width, clone_height,
+					p->clonedumb->strides[0],
+					p->clonedumb->size,
+					clonedmafd);
+			p->clonedumb->dmafd = clonedmafd;	
+		}
+	}
+}
