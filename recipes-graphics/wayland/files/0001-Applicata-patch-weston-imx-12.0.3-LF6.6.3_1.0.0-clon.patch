+static void load_cloneoutput(struct weston_config *wc, struct weston_drm_backend_config *config )
+{
+	struct weston_config_section *section = NULL;
+	const char *section_name;
+	uint32_t conn_id;
+	int output_num = 0;
+	int output_index = 0;
+
+	config->cloneoutput = malloc(sizeof(struct cloneoutput*));
+
+	while(weston_config_next_section(wc, &section, &section_name)){
+		char *s;
+		int n;
+		uint32_t width = 0;
+		uint32_t height = 0;
+
+		if(strcmp(section_name, "cloneoutput") != 0){
+			continue;
+		}
+		weston_config_section_get_string(section, "mode", &s,NULL);
+		if(strcmp(s, "off")==0) continue;
+
+		n = sscanf(s, "%dx%d", &width, &height);
+		output_num++;
+		output_index = output_num - 1;
+
+		config->cloneoutput = realloc(config->cloneoutput, (output_num)*sizeof(config->cloneoutput[0]));
+	    weston_config_section_get_uint(section, "conn_id",&conn_id, 0);
+		config->cloneoutput[output_index].conn_id = conn_id;
+		if (n == 2 && width > 0 && height > 0) {
+			config->cloneoutput[output_index].width  = width;
+			config->cloneoutput[output_index].height = height;
+		}
+		free(s);	
+		config->modecount = output_num;		
+	}	
+}
+
 static int
 load_drm_backend(struct weston_compositor *c, int *argc, char **argv,
 		 struct weston_config *wc, enum weston_renderer_type renderer)
@@ -2974,6 +3012,10 @@ load_drm_backend(struct weston_compositor *c, int *argc, char **argv,
 #if defined(ENABLE_IMXG2D)
 	weston_config_section_get_bool(section, "use-g2d", &config.use_g2d,
 				       use_g2d);
+	weston_config_section_get_uint(section, "clone-mode", &config.clone_mode, 0);
+	weston_config_section_get_uint(section, "clone-connector-id", &config.clone_connid, 0);
+	weston_config_section_get_uint(section, "extend-connector-id", &config.clone_extend, 0);
+	load_cloneoutput(wc,&config);					   
 #endif
 
 	const struct weston_option options[] = {
@@ -2984,6 +3026,9 @@ load_drm_backend(struct weston_compositor *c, int *argc, char **argv,
 		{ WESTON_OPTION_BOOLEAN, "use-pixman", 0, &force_pixman },
 #if defined(ENABLE_IMXG2D)
 		{ WESTON_OPTION_BOOLEAN, "use-g2d", 0, &config.use_g2d },
+		{ WESTON_OPTION_INTEGER, "clone-mode", 0, &config.clone_mode },
+		{ WESTON_OPTION_INTEGER, "clone-connector-id", 0, &config.clone_connid },
+		{ WESTON_OPTION_INTEGER, "extend-connector-id", 0, &config.clone_extend },
 #endif
