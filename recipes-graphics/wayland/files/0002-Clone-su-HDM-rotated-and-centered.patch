From 62bbdde8df862ced061404acfe27f58e2d4bdabc Mon Sep 17 00:00:00 2001
From: Andrea Collamati <andrea.collamati@elettronicagf.it>
Date: Fri, 3 Jan 2025 15:45:07 +0100
Subject: [PATCH 2/4] Clone su HDM rotated and centered -Tested with 890 15"
 and HDMI

---
 libweston/renderer-g2d/g2d-renderer.c | 18 ++++++++++++++----
 1 file changed, 14 insertions(+), 4 deletions(-)

diff --git a/libweston/renderer-g2d/g2d-renderer.c b/libweston/renderer-g2d/g2d-renderer.c
index f20652ac..70b7ab46 100644
--- a/libweston/renderer-g2d/g2d-renderer.c
+++ b/libweston/renderer-g2d/g2d-renderer.c
@@ -211,17 +211,27 @@ get_renderer(struct weston_compositor *ec)
 	}else{
 		dstg2dSurface->base.rot = G2D_ROTATION_0;
 	}
+	dstg2dSurface->base.rot = G2D_ROTATION_90;
 	dstg2dSurface->base.blendfunc = G2D_ONE_MINUS_SRC_ALPHA;
-	dstg2dSurface->base.left = 0;
-	dstg2dSurface->base.right = dstg2dSurface->base.width;
+	dstg2dSurface->base.left = (1920-640)/2;
+	dstg2dSurface->base.right = 640 + (1920-640)/2;
 	dstg2dSurface->base.top = 0;
 	dstg2dSurface->base.bottom = dstg2dSurface->base.height;
 	dstg2dSurface->base.width = dstg2dSurface->base.width;
 	dstg2dSurface->base.height = dstg2dSurface->base.height;
+	dstg2dSurface->base.clrcolor = 0xFF000000;	
 
 	g2d_set_clipping(gr->handle,0,0,dstg2dSurface->base.right,dstg2dSurface->base.height);
-
 	g2d_blitEx(gr->handle,srcg2dSurface,dstg2dSurface);
+
+	// need to clean left area. It remains dirty..
+	dstg2dSurface->base.left = 0;
+	dstg2dSurface->base.right =  (1920-640)/2;
+	dstg2dSurface->base.top = 0;
+	dstg2dSurface->base.bottom = dstg2dSurface->base.height;
+	dstg2dSurface->base.width = dstg2dSurface->base.width;
+	dstg2dSurface->base.height = dstg2dSurface->base.height;
+	g2d_clear(gr->handle,&dstg2dSurface->base);
 	g2d_flush(gr->handle);
 	g2d_finish(gr->handle);
 	
@@ -2439,7 +2449,7 @@ drm_create_g2d_image(struct g2d_surfaceEx* g2dSurface,
 	struct g2d_renderer *gr = get_renderer(ec);
    	struct g2d_buf *d_buf = g2d_buf_from_fd(dmafd2);
 	struct g2d_buf *s_buf = g2d_buf_from_fd(dmafd1);
-    g2d_copy(gr->handle,d_buf,s_buf,size);
+		g2d_copy(gr->handle,d_buf,s_buf,size);
 	g2d_flush(gr->handle);
 		
 }
-- 
