 	srcg2dSurface->base.width = srcg2dSurface->base.width;
 	srcg2dSurface->base.height = srcg2dSurface->base.height;
 	srcg2dSurface->base.blendfunc = G2D_ONE;
+	weston_log("clone_mode_g2d_blit=%d\n",custom_conf);
+	switch (custom_conf)
+	{
+	case 0: // original clone mode from NXP
+	{
+		if (dstg2dSurface->base.width < dstg2dSurface->base.height && srcg2dSurface->base.width > srcg2dSurface->base.height)
+		{
+			dstg2dSurface->base.rot = G2D_ROTATION_270;
+		}
+		else
+		{
+			dstg2dSurface->base.rot = G2D_ROTATION_0;
+		}
+		dstg2dSurface->base.blendfunc = G2D_ONE_MINUS_SRC_ALPHA;
+		dstg2dSurface->base.left = 0;
+		dstg2dSurface->base.right = dstg2dSurface->base.width;
+		dstg2dSurface->base.top = 0;
+		dstg2dSurface->base.bottom = dstg2dSurface->base.height;
+		g2d_set_clipping(gr->handle, 0, 0, dstg2dSurface->base.right, dstg2dSurface->base.height);
+		g2d_blitEx(gr->handle, srcg2dSurface, dstg2dSurface);
 
+		break;
+	}
+	case 1:
+	case 2:
+	{		
+		// Output su HDMI 1024x600 centered not scaled
+		const wClone = 600;
+		const hClone = 1024;
+		const int xOffset = (1920-wClone)/2;
+		const int yOffset = (1080-hClone)/2;
+
+		// Should be rotated because DSI is rotated
+		dstg2dSurface->base.rot = (custom_conf == 1 ? G2D_ROTATION_90 : G2D_ROTATION_270);
+		dstg2dSurface->base.blendfunc = G2D_ONE_MINUS_SRC_ALPHA;
+		dstg2dSurface->base.left =  xOffset;
+		dstg2dSurface->base.right = xOffset + wClone;
+		dstg2dSurface->base.top = yOffset;
+		dstg2dSurface->base.bottom =  yOffset + hClone;
+		g2d_set_clipping(gr->handle, 0, 0, dstg2dSurface->base.right, dstg2dSurface->base.height);
+		g2d_blitEx(gr->handle, srcg2dSurface, dstg2dSurface);
+#if 0
+		// need to clean left area. It remains dirty..
+		dstg2dSurface->base.left = 0;
+		dstg2dSurface->base.right = x_offset_dest - 1;
+		dstg2dSurface->base.top = 0;
+		dstg2dSurface->base.bottom = dstg2dSurface->base.height;
