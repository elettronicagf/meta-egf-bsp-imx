Date: Wed, 22 Jan 2025 16:54:50 +0100
Subject: [PATCH 4/4] Added option in weston.ini to enable custom clone mode.
 key custom_conf in cloneoutput section

0 = As implemente by NXP (Destination fullscreen not rotated),
1 = Destination 1024x600 Rotation (90) and center alignment
2 = Destination 1024x600 Rotation (270) and center alignment

Example: imx8mp-egf-3hi4005.dtb + HDMI 1920x1080

[core]
#gbm-format=argb8888
use-g2d=true
repaint-window=16
idle-time=0
xwayland=true
#enable-overlay-view=1
#shell=kiosk-shell.so
clone-mode=1
#DSI
clone-connector-id=38

[cloneoutput]
#HDMI
conn_id=40
custom_conf=2
mode=1920x1080@60


[output]
name=DSI-1
#mode=1920x1080@60
transform=rotate-270

[output]
name=HDMI-A-1
mode=1920x1080@60
#mode=off
[cloneoutput]
#HDMI
conn_id=40
custom_conf=2
mode=1920x1080@60
